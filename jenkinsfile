// Runs on ANY Jenkins whose agent has Docker. No terraform/aws/go pre-installed
// Every tool runs in its official image via deploy/ci/dtool.sh

pipeline {
  agent any

  parameters {
    choice(name: 'ACTION', choices: ['apply', 'destroy'], description: 'Terraform action')
    string(name: 'REGION', defaultValue: 'eu-central-1', description: 'AWS region')
    booleanParam(name: 'ENABLE_WAF', defaultValue: false, description: 'Attach AWS WAF')
    string(name: 'MAX_INSTANCES', defaultValue: '2', description: 'Autoscaling max instances')
  }

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  environment {
    AWS_DEFAULT_REGION = "${params.REGION}"
    TF_DIR     = 'deploy/terraform'
    DTOOL      = './deploy/ci/dtool.sh'
    TF_IMG     = 'hashicorp/terraform:1.9.8'
    AWS_IMG    = 'amazon/aws-cli:latest'
    GO_IMG     = 'golang:1.26'
    CURL_IMG   = 'curlimages/curl:latest'
    LOCK_TABLE = 'pingpong-tf-lock'
  }

  stages {
    stage('Checkout') {
      steps {
        script {
          def scmVars = checkout scm
          env.IMAGE_TAG = scmVars.GIT_COMMIT.take(7)
        }
      }
    }

    stage('Test') {
      when { expression { params.ACTION == 'apply' } }
      steps {
        sh '$DTOOL $GO_IMG go test ./...'
      }
    }

    stage('Prepare backend') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'aws-pingpong-ci', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
          script {
            def acct = sh(returnStdout: true, script: '$DTOOL $AWS_IMG sts get-caller-identity --query Account --output text').trim()
            env.STATE_BUCKET = "pingpong-tfstate-${acct}-${params.REGION}"
            env.ECR_REGISTRY = "${acct}.dkr.ecr.${params.REGION}.amazonaws.com"
          }
          sh '''
            set -e
            AWS="$DTOOL $AWS_IMG"
            if ! $AWS s3api head-bucket --bucket "$STATE_BUCKET" 2>/dev/null; then
              if [ "$AWS_DEFAULT_REGION" = "us-east-1" ]; then
                $AWS s3api create-bucket --bucket "$STATE_BUCKET"
              else
                $AWS s3api create-bucket --bucket "$STATE_BUCKET" \
                  --create-bucket-configuration LocationConstraint="$AWS_DEFAULT_REGION"
              fi
              $AWS s3api put-bucket-versioning --bucket "$STATE_BUCKET" \
                --versioning-configuration Status=Enabled
            fi
            if ! $AWS dynamodb describe-table --table-name "$LOCK_TABLE" >/dev/null 2>&1; then
              $AWS dynamodb create-table --table-name "$LOCK_TABLE" --billing-mode PAY_PER_REQUEST \
                --attribute-definitions AttributeName=LockID,AttributeType=S \
                --key-schema AttributeName=LockID,KeyType=HASH
              $AWS dynamodb wait table-exists --table-name "$LOCK_TABLE"
            fi
          '''
        }
      }
    }

    stage('Terraform init') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'aws-pingpong-ci', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
          sh '''
            $DTOOL $TF_IMG -chdir=$TF_DIR init -input=false -reconfigure \
              -backend-config="bucket=$STATE_BUCKET" \
              -backend-config="key=pingpong/app-runner.tfstate" \
              -backend-config="region=$AWS_DEFAULT_REGION" \
              -backend-config="dynamodb_table=$LOCK_TABLE"
          '''
        }
      }
    }

    stage('Ensure ECR') {
      when { expression { params.ACTION == 'apply' } }
      steps {
        withCredentials([usernamePassword(credentialsId: 'aws-pingpong-ci', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
          sh '''
            $DTOOL $TF_IMG -chdir=$TF_DIR apply -input=false -auto-approve \
              -target=aws_ecr_repository.pingpong \
              -var image_tag=$IMAGE_TAG -var region=$AWS_DEFAULT_REGION
          '''
        }
      }
    }

    stage('Build & push image') {
      when { expression { params.ACTION == 'apply' } }
      steps {
        withCredentials([usernamePassword(credentialsId: 'aws-pingpong-ci', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
          sh 'docker build -t pingpong:$IMAGE_TAG .'
          retry(3) {
            sh '''
              set -e
              $DTOOL $AWS_IMG ecr get-login-password | docker login --username AWS --password-stdin $ECR_REGISTRY
              docker tag pingpong:$IMAGE_TAG $ECR_REGISTRY/pingpong:$IMAGE_TAG
              docker push $ECR_REGISTRY/pingpong:$IMAGE_TAG
            '''
          }
        }
      }
    }

    stage('Terraform apply') {
      when { expression { params.ACTION == 'apply' } }
      steps {
        withCredentials([usernamePassword(credentialsId: 'aws-pingpong-ci', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
          sh '''
            $DTOOL $TF_IMG -chdir=$TF_DIR apply -input=false -auto-approve \
              -var image_tag=$IMAGE_TAG \
              -var region=$AWS_DEFAULT_REGION \
              -var custom_domain=$CUSTOM_DOMAIN \
              -var hosted_zone_id=$HOSTED_ZONE_ID \
              -var enable_waf=$ENABLE_WAF \
              -var max_instances=$MAX_INSTANCES
          '''
        }
      }
    }

    stage('Smoke') {
      when { expression { params.ACTION == 'apply' } }
      steps {
        withCredentials([usernamePassword(credentialsId: 'aws-pingpong-ci', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
          sh '''
            set -e
            URL=$($DTOOL $TF_IMG -chdir=$TF_DIR output -raw service_url)
            echo "Service URL: $URL"
            code=$(docker run --rm $CURL_IMG -s -o /dev/null -w '%{http_code}' -X POST -H 'NotBad: true' "$URL/")
            [ "$code" = "200" ] || { echo "POST+NotBad expected 200, got $code"; exit 1; }
            body=$(docker run --rm $CURL_IMG -s -X POST -H 'NotBad: true' "$URL/")
            [ "$body" = "ReallyNotBad" ] || { echo "expected ReallyNotBad, got '$body'"; exit 1; }
            code=$(docker run --rm $CURL_IMG -s -o /dev/null -w '%{http_code}' -X POST "$URL/")
            [ "$code" = "403" ] || { echo "POST no-header expected 403, got $code"; exit 1; }
            echo "SMOKE PASSED: $URL"
          '''
        }
      }
    }

    stage('Terraform destroy') {
      when { expression { params.ACTION == 'destroy' } }
      steps {
        withCredentials([usernamePassword(credentialsId: 'aws-pingpong-ci', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
          sh '''
            $DTOOL $TF_IMG -chdir=$TF_DIR destroy -input=false -auto-approve \
              -var image_tag=$IMAGE_TAG \
              -var region=$AWS_DEFAULT_REGION \
              -var custom_domain=$CUSTOM_DOMAIN \
              -var hosted_zone_id=$HOSTED_ZONE_ID \
              -var enable_waf=$ENABLE_WAF \
              -var max_instances=$MAX_INSTANCES
          '''
        }
      }
    }
  }
}
